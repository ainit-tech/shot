# Rust build output
/target/

# Temporary files, kept out of git in every repository
/tmp/

# A release built by ci/build.sh, and the languages of its installer, which it writes from the
# catalogs (tools/installer-texts.py)
/dist/
/installer/languages.iss

# Node.js dependencies
node_modules/

# Documentation site: build output, and everything in public/ is generated by tools/docs/engine
/tools/docs/ui/dist/
/tools/docs/ui/public/

# Local tool settings
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
