; *** Inno Setup version 6.7.3+ Filipino messages, for ainitShot ***
; Only the messages that the installer and the uninstaller of ainitShot show; the rest come from
; Default.isl, which the installer lays under this file. Written for ainitShot, 2026-10-25.

[LangOptions]
LanguageName=Filipino
LanguageID=$0464
LanguageCodePage=0

